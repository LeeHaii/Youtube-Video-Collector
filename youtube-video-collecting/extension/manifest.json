{
  "manifest_version": 3,
  "name": "Rhymx Collector Links",
  "version": "1.0.0",
  "description": "Open YouTube links from Google Sheets in the Rhymx collector.",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "storage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "https://www.youtu.be/*",
    "https://www.google.com/*",
    "https://google.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Collector links" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
